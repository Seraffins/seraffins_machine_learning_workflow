# =====================================================================
# API (Cloud Run). Locally: copy to api/.env
# Comments must stay on their own lines (docker --env-file does not strip them).
# =====================================================================

# development locally, production on Cloud Run
ENV=development

# Supabase TRANSACTION pooler (port 6543): used by the running app
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase SESSION pooler (port 5432): used only by `alembic upgrade`
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_KEYS: for the frontend's backend; comma-separate two keys while rotating
API_KEYS=change-me
# ADMIN_KEYS: only you
ADMIN_KEYS=change-me

# The frontend's R2 image host(s)
ALLOWED_IMAGE_HOSTS=pub-xxxx.r2.dev

# Empty = server-to-server only (recommended). Set origins only if a browser calls the API directly.
CORS_ORIGINS=

# true locally, false in production
ENABLE_DOCS=true

MODAL_TOKEN_ID=ak-xxxx
MODAL_TOKEN_SECRET=as-xxxx

# Optional tuning
# RATE_LIMIT_PER_UID=10
# RATE_LIMIT_PER_KEY=300

# =====================================================================
# Modal secret "turtle-secrets" (GPU worker), set with `modal secret create`
# =====================================================================
# DATABASE_URL=<same transaction pooler URL as above>
# STORAGE_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# STORAGE_REGION=ap-south-1
# STORAGE_BUCKET=turtle-crops
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
# Optional webhook to the frontend's backend:
# WEBHOOK_URL=https://frontend-backend.example.com/turtle-webhook
# WEBHOOK_SECRET=<random string shared with the frontend backend>
